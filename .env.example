# =====================================================
# Frontend Environment Variables (Vite)
# =====================================================

# Clerk Authentication Publishable Key (from https://dashboard.clerk.com)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here

# Allowed Admin Emails (comma-separated list of emails allowed to access admin portal)
VITE_ADMIN_EMAILS=eddy@autos.com,admin@autos.com

# Backend API URL (use http://localhost:5001 for local dev, or your production backend URL)
VITE_API_URL=http://localhost:5001