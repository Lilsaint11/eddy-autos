# =====================================================
# Backend Environment Variables (Express & Database)
# =====================================================

# Neon / PostgreSQL Database Connection URL
DATABASE_URL=postgresql://username:password@ep-example.us-east-1.aws.neon.tech/neondb?sslmode=require

# Server Port
PORT=5001

# Cloudinary Storage Credentials (from https://cloudinary.com/console)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Optional: Frontend URL for CORS if deployed
# CLIENT_URL=https://eddy-autos.vercel.app
